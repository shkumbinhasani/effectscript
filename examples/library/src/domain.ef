export interface Book {
  readonly id: string
  readonly title: string
  readonly author: string
  readonly loan?: Loan
}

export interface Loan {
  readonly member: string
  readonly dueAt: number
}

export const NewBook = Schema.Struct({
  title: Schema.NonEmptyTrimmedString,
  author: Schema.NonEmptyTrimmedString
})

export const BorrowRequest = Schema.Struct({
  member: Schema.NonEmptyTrimmedString
})

export const LoanPeriod = Duration.days(14)

export const FeePerDay = 25

export class BookNotFound extends Data.TaggedError("BookNotFound")<{ readonly id: string }> {}

export class AlreadyBorrowed extends Data.TaggedError("AlreadyBorrowed")<{
  readonly id: string
  readonly member: string
}> {}

export class NotBorrowed extends Data.TaggedError("NotBorrowed")<{ readonly id: string }> {}

export class InvalidInput extends Data.TaggedError("InvalidInput")<{ readonly message: string }> {}

export function lateFee(dueAt: number, returnedAt: number): number {
  const daysLate = Math.ceil((returnedAt - dueAt) / Duration.toMillis(Duration.days(1)))
  return Math.max(0, daysLate) * FeePerDay
}
