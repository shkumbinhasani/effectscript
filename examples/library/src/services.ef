import { Ref } from "effect"
import { BookNotFound, type Book } from "./domain.js"

export class BookRepo extends Context.Tag("BookRepo")<
  BookRepo,
  {
    readonly all: Effect.Effect<ReadonlyArray<Book>>
    readonly find: (id: string) => Effect.Effect<Book, BookNotFound>
    readonly save: (book: Book) => Effect.Effect<void>
  }
>() {}

export class Ids extends Context.Tag("Ids")<Ids, { readonly next: Effect.Effect<string> }>() {}

export class AuditLog extends Context.Tag("AuditLog")<
  AuditLog,
  {
    readonly record: (event: string) => Effect.Effect<void>
    readonly entries: Effect.Effect<ReadonlyArray<string>>
  }
>() {}

type Store = Ref.Ref<ReadonlyMap<string, Book>>

effect async function findIn(store: Store, id: string): Book
  throws BookNotFound
{
  const books = await Ref.get(store)
  const book = books.get(id)
  if (!book) throw new BookNotFound({ id })
  return book
}

effect async function makeBookRepo(seed: ReadonlyArray<Book>) {
  const store = await Ref.make<ReadonlyMap<string, Book>>(new Map(seed.map((book) => [book.id, book])))
  return BookRepo.of({
    all: Effect.map(Ref.get(store), (books) => [...books.values()]),
    find: (id) => findIn(store, id),
    save: (book) => Ref.update(store, (books) => new Map(books).set(book.id, book))
  })
}

effect async function makeIds(prefix: string) {
  const counter = await Ref.make(0)
  return Ids.of({
    next: Effect.map(Ref.updateAndGet(counter, (n) => n + 1), (n) => `${prefix}${n}`)
  })
}

effect async function makeAuditLog(echo: boolean) {
  const entries = await Ref.make<ReadonlyArray<string>>([])
  return AuditLog.of({
    record: (event) =>
      Effect.zipRight(
        Ref.update(entries, (all) => [...all, event]),
        echo ? Console.log(`[audit] ${event}`) : Effect.void
      ),
    entries: Ref.get(entries)
  })
}

export const seedBooks: ReadonlyArray<Book> = [
  { id: "b1", title: "Structure and Interpretation of Computer Programs", author: "Abelson & Sussman" },
  { id: "b2", title: "Types and Programming Languages", author: "Benjamin C. Pierce" }
]

export function makeAppLayer(options: { readonly seed: ReadonlyArray<Book>; readonly echo: boolean }) {
  return Layer.mergeAll(
    Layer.effect(BookRepo, makeBookRepo(options.seed)),
    Layer.effect(Ids, makeIds("b")),
    Layer.effect(AuditLog, makeAuditLog(options.echo))
  )
}
