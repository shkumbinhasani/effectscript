import { Clock, ParseResult } from "effect"
import {
  AlreadyBorrowed,
  BookNotFound,
  BorrowRequest,
  InvalidInput,
  LoanPeriod,
  NewBook,
  NotBorrowed,
  lateFee,
  type Book
} from "./domain.js"
import { AuditLog, BookRepo, Ids } from "./services.js"

export effect async function decode<A, I>(schema: Schema.Schema<A, I>, input: unknown): A
  throws InvalidInput
{
  try {
    return await Schema.decodeUnknown(schema)(input)
  } catch (error) {
    throw new InvalidInput({ message: ParseResult.TreeFormatter.formatErrorSync(error) })
  }
}

export effect async function listBooks(): ReadonlyArray<Book>
  requires BookRepo
{
  const repo = use BookRepo
  return await repo.all
}

export effect async function addBook(input: unknown): Book
  requires BookRepo | Ids | AuditLog
  throws InvalidInput
{
  const repo = use BookRepo
  const ids = use Ids
  const audit = use AuditLog

  const { title, author } = await decode(NewBook, input)
  const book: Book = { id: await ids.next, title, author }

  await repo.save(book)
  await audit.record(`added ${book.id} "${title}"`)
  return book
}

export effect async function borrowBook(id: string, input: unknown): Book
  requires BookRepo | AuditLog
  throws BookNotFound | AlreadyBorrowed | InvalidInput
{
  const repo = use BookRepo
  const audit = use AuditLog

  const { member } = await decode(BorrowRequest, input)
  const book = await repo.find(id)
  if (book.loan) throw new AlreadyBorrowed({ id, member: book.loan.member })

  const now = await Clock.currentTimeMillis
  const borrowed: Book = { ...book, loan: { member, dueAt: now + Duration.toMillis(LoanPeriod) } }

  await repo.save(borrowed)
  await audit.record(`${member} borrowed ${id}`)
  return borrowed
}

export effect async function returnBook(id: string) {
  const repo = use BookRepo
  const audit = use AuditLog

  const book = await repo.find(id)
  if (!book.loan) throw new NotBorrowed({ id })

  const now = await Clock.currentTimeMillis
  const fee = lateFee(book.loan.dueAt, now)
  const { loan, ...returned } = book

  await repo.save(returned)
  await audit.record(`${loan.member} returned ${id}${fee > 0 ? `, late fee ${fee}` : ""}`)
  return { book: returned, fee }
}

export effect async function auditTrail(): ReadonlyArray<string>
  requires AuditLog
{
  const audit = use AuditLog
  return await audit.entries
}
